#. Plugin Name of the plugin
#: plogins-recover.php
msgid "Plogins Recover - Abandoned Cart for WooCommerce"
msgstr "Plogins Recover - porzucone koszyki dla WooCommerce"

#. Plugin URI of the plugin
#: plogins-recover.php
msgid "https://plogins.com/plogins-recover/"
msgstr "https://plogins.com/plogins-recover/"

#. Description of the plugin
#: plogins-recover.php
msgid ""
"Capture carts that are left behind and email customers a one-click link to "
"finish checkout."
msgstr ""
"Przechwytuj porzucone koszyki i wysyłaj klientom e-mailem link umożliwiający "
"dokończenie zakupów jednym kliknięciem."

#. Author of the plugin
#: plogins-recover.php
msgid "WPPoland.com"
msgstr "WPPoland.com"

#. Author URI of the plugin
#: plogins-recover.php
msgid "https://wppoland.com"
msgstr "https://wppoland.com"

#. translators: 1: Required PHP version, 2: Current PHP version
#: plogins-recover.php:51
#, php-format
msgid "Recover requires PHP %1$s or higher. You are running PHP %2$s."
msgstr "Wtyczka Recover wymaga PHP %1$s lub nowszego. Używasz PHP %2$s."

#: plogins-recover.php:67
msgid ""
"Recover - Abandoned Cart Recovery for WooCommerce requires WooCommerce to be "
"installed and activated."
msgstr ""
"Wtyczka Recover - Odzyskiwanie porzuconych koszyków dla WooCommerce wymaga "
"zainstalowanej i aktywnej wtyczki WooCommerce."

#. translators: 1: Required WC version, 2: Current WC version
#: plogins-recover.php:79
#, php-format
msgid ""
"Recover requires WooCommerce %1$s or higher. You are running WooCommerce "
"%2$s."
msgstr ""
"Wtyczka Recover wymaga WooCommerce %1$s lub nowszego. Używasz WooCommerce "
"%2$s."

